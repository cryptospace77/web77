# Crypto Space 77 ─── dynamic url handling
# Install the app in the root directory for dynamic urls to work
# /@username
# /@username/permlink
# /c/@username/permlink
# /trending  /hot  /created  /tags  /welcome  /imprint
# /trending/tag  /hot/tag  /created/tag

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [QSA,L]
</IfModule>

<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>

<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>
